# cronbird configuration example
# Copy this file to .env and adjust the values as needed

# Listen address (default: 0.0.0.0:8080)
CRONBIRD_LISTEN=0.0.0.0:8080

# Comma-separated list of predefined identities (required if ALLOW_DYNAMIC=false)
CRONBIRD_IDENTITIES=clickhouse-backup-prod,pg-backup-staging,redis-backup-prod

# Allow dynamic identities (accept unknown identities on POST)
# Set to true to accept any identity without predefinition
# Set to false to only accept identities listed in CRONBIRD_IDENTITIES
CRONBIRD_ALLOW_DYNAMIC=false

# Bearer token for authentication (optional)
# If set, all POST /callback/* requests must include "Authorization: Bearer <token>"
# Leave empty to disable authentication
CRONBIRD_AUTH_TOKEN=

# Protect metrics endpoints with authentication (optional, default: false)
# Requires CRONBIRD_AUTH_TOKEN to be set. When enabled, GET /metrics and
# GET /metrics/{identity} require "Authorization: Bearer <token>".
# Configure Prometheus/VictoriaMetrics scrape_configs with bearer_token to authenticate.
CRONBIRD_PROTECT_METRICS=false

# Path to state persistence file (default: ./cronbird-state.json)
# For Docker deployments, use /data/cronbird-state.json
CRONBIRD_PERSIST_PATH=./cronbird-state.json

# Persistence interval in seconds (default: 60)
# How often to write state to disk
CRONBIRD_PERSIST_INTERVAL=60

# Log level (debug, info, warn, error)
CRONBIRD_LOG_LEVEL=info
